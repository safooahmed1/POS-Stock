{
  "version": 2,
  "buildCommand": "npm run build && cp -r client/dist dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "server/index.js": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "outputDirectory": "dist"
}